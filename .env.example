# Copy to .env and fill in every value. .env is git-ignored and must never be committed.
# Both docker compose and the Spring Boot application read it:
#   - docker compose substitutes ${VARS} from .env automatically
#   - Spring Boot imports it via spring.config.import=optional:file:.env[.properties]
# In production, set these as real environment variables (or secrets) instead of using a file.
#
# Generate strong passwords, for example:  openssl rand -base64 24

# --- PostgreSQL superuser: only for the optional docker-compose.yml; the application never uses it
POSTGRES_PASSWORD=

# --- Database connection used by the application
WMS_DB_URL=jdbc:postgresql://localhost:5432/warehouse_db
# Optional: a separate database for integration tests (default: the database above).
# WMS_TEST_DB_URL=jdbc:postgresql://localhost:5432/warehouse_db_test
WMS_DB_POOL_SIZE=10

# Schema owner: Flyway connects as this role to run migrations (DDL)
WMS_DB_OWNER_USER=wms_owner
WMS_DB_OWNER_PASSWORD=

# Runtime role: the application connects as this role (data only, no DDL)
WMS_DB_APP_USER=wms_app
WMS_DB_APP_PASSWORD=

# --- Application
# IANA time zone for calendar-date rules such as batch expiry. Default Asia/Baku.
WMS_BUSINESS_TIMEZONE=Asia/Baku
# Maximum CSV import upload size. Default 5MB.
WMS_IMPORT_MAX_FILE_SIZE=5MB
# Comma-separated browser origins allowed to call the API (CORS). Empty = none allowed.
# Example: https://app.example.com,https://admin.example.com
WMS_CORS_ALLOWED_ORIGINS=

# --- Security
# HMAC key for signing access tokens: Base64, at least 256 bits. Required.
#   openssl rand -base64 48
WMS_JWT_SECRET=
# Access token lifetime (ISO-8601 duration). Default PT15M.
WMS_JWT_ACCESS_TOKEN_TTL=PT15M
# BCrypt cost factor. Default 12; each +1 doubles hashing time.
WMS_BCRYPT_STRENGTH=12

# First administrator, created at startup only when no active ADMIN exists.
# The password must be 10-64 characters with at least one letter and one digit.
# You can remove these values once the administrator exists.
WMS_BOOTSTRAP_ADMIN_USERNAME=admin
WMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WMS_BOOTSTRAP_ADMIN_PASSWORD=
